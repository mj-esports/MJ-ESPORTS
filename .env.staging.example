# ============================================================================
# MJ ESPORTS — Staging Environment Configuration Template (.env.staging.example)
# Target Project: mj-esports-staging (Separate Supabase Staging Project)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.staging:
#      cp .env.staging.example .env.staging
# 2. Enter your staging credentials from the Supabase Dashboard (Settings -> API).
# 3. DO NOT enter production credentials (mjesports) here.
# 4. .env.staging is automatically ignored by Git to prevent credential leakage.
# ============================================================================

# Supabase Staging Project Credentials (REQUIRED)
# Replace with actual credentials from your mj-esports-staging project:
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-supabase-anon-key-here

# Staging Environment Safety Validation (OPTIONAL but Recommended)
# Provide the expected staging project ref (e.g. your-staging-project-ref) so the client
# startup safety guard can verify staging mode never points to the production project.
# VITE_EXPECTED_STAGING_PROJECT_REF=your-staging-project-ref

# Payment Gateway Feature Flag (STRICT RESTRICTION: Keep false until authorized)
VITE_FAMGATEWAY_ENABLED=false


# Cloudflare Turnstile Bot Protection (Optional: Leave blank in staging to bypass)
# VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Community Social Handles (Footer Links)
# VITE_INSTAGRAM_URL=https://instagram.com/mjesports_staging
# VITE_WHATSAPP_URL=https://chat.whatsapp.com/staging_invite_code
