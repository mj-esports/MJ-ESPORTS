# Supabase Configuration
# Replace these values with your actual project credentials from your Supabase Dashboard (Settings -> API)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Payment Gateway Configuration (Frontend Feature Flags)
# Toggle FamGateway tournament checkout (defaults to true if unset in development, set to false to disable)
VITE_FAMGATEWAY_ENABLED=true

# Supabase Edge Function Secrets (Set via: supabase secrets set KEY=VALUE)
# DO NOT expose these in client-side Vite code (.env files deployed to Vercel/client bundle)
# FAMGATEWAY_API_KEY=your-famgateway-api-v2-key
# FAMGATEWAY_API_URL=https://famgateway.in/api
# FAMGATEWAY_ENABLED=true
# FAMGATEWAY_REDIRECT_URL=https://your-domain.com


# Official Community & Social Channels (Footer Links)
# Supply either full HTTPS URLs or handles/numbers:
# VITE_INSTAGRAM_URL=https://instagram.com/your_official_handle
# VITE_WHATSAPP_URL=https://chat.whatsapp.com/your_community_invite_code
# VITE_WHATSAPP_NUMBER=9876543210
